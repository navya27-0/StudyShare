# Backend Environment Configuration
ENVIRONMENT=development
DEBUG=True
APP_NAME=StudyShare API
BACKEND_PORT=8000

# Database Configuration (PostgreSQL in Docker, SQLite fallback for local development without Docker)
DATABASE_URL=postgresql+asyncpg://studyshare:studyshare_dev@localhost:5432/studyshare_db
# For lightweight local run without Postgres running:
# DATABASE_URL=sqlite+aiosqlite:///./studyshare.db

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
