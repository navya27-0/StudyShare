# Root Monorepo Environment Configuration
# Copy to .env or service-specific .env files before running

# Database (PostgreSQL)
POSTGRES_USER=studyshare
POSTGRES_PASSWORD=studyshare_dev
POSTGRES_DB=studyshare_db
POSTGRES_PORT=5432

# Backend (FastAPI)
ENVIRONMENT=development
DEBUG=True
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://studyshare:studyshare_dev@localhost:5432/studyshare_db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend (Vite)
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
