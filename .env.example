# ==============================================================================
# StudyShare — Environment Configuration Reference
# ==============================================================================
# Copy this file to '.env' before launching the application:
#   cp .env.example .env
#
# Development defaults work out-of-the-box with 'docker compose up'.
# In production, replace default passwords and generate a secure random JWT secret.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Database superuser credentials
POSTGRES_USER=studyshare
# IMPORTANT: In production, generate a strong random password!
POSTGRES_PASSWORD=studyshare_dev
POSTGRES_DB=studyshare_db

# Host port mapping for local access (default: 5433 to avoid conflict with local PostgreSQL 5432)
POSTGRES_HOST_PORT=5433

# ------------------------------------------------------------------------------
# 2. BACKEND API (FastAPI + SQLAlchemy)
# ------------------------------------------------------------------------------
# Environment mode: 'development' or 'production'
ENVIRONMENT=development

# Enable interactive OpenAPI Swagger docs at /docs and verbose traceback logging
DEBUG=True

# Internal service port
BACKEND_PORT=8000

# Full async database connection URL (asyncpg driver)
# When running via Docker Compose, host is 'postgres':
DATABASE_URL=postgresql+asyncpg://studyshare:studyshare_dev@postgres:5432/studyshare_db
# For local development outside Docker, use localhost and POSTGRES_HOST_PORT:
# DATABASE_URL=postgresql+asyncpg://studyshare:studyshare_dev@localhost:5433/studyshare_db

# Allowed CORS origins (comma-separated list, no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Secret key used for signing JWT access and refresh tokens.
# IN PRODUCTION: Generate using `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET_KEY=studyshare_jwt_secret_dev_key_change_in_production_9e4f01a2

# Token signing algorithm (HS256)
JWT_ALGORITHM=HS256

# Access token lifespan in minutes (recommended: 15 to 60)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token lifespan in days (recommended: 7 to 30)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Brute-force protection: Max failed login attempts before temporary lockout
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Brute-force lockout window duration in seconds (300s = 5 minutes)
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# ------------------------------------------------------------------------------
# 4. STORAGE & FILE UPLOADS
# ------------------------------------------------------------------------------
# Local directory path for storing uploaded lecture notes and PDFs
UPLOAD_DIR=/app/uploads

# Maximum allowed upload payload in bytes (52428800 = 50 MB)
MAX_UPLOAD_SIZE_BYTES=52428800

# ------------------------------------------------------------------------------
# 5. FRONTEND CLIENT (React + Vite + Nginx)
# ------------------------------------------------------------------------------
# Host port mapping for frontend web application (development default: 5173, production: 80)
FRONTEND_PORT=5173

# Base API URL consumed by the browser client
# In Docker, Nginx reverse-proxies /api/ directly, or you can point to http://localhost:8000
VITE_API_URL=http://localhost:8000
